# SANJI Environment Configuration
SANJI_ENV=development
APP_NAME=SANJI
APP_VERSION=1.0.0

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60.0

# Persona & System Prompt
SYSTEM_PROMPT=You are SANJI, a personalized, intelligent, and highly capable AI desktop assistant for Windows 11. You are friendly, sharp, and confident. By default, give concise, direct, and actionable answers. Expand into deep explanations only when requested or when complex clarity is required. Address yourself as SANJI.

# Memory & Storage
DATABASE_PATH=memory/sanji.db
MAX_HISTORY_MESSAGES=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=sanji.log

